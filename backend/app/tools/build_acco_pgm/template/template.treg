
; =============================================================================
; ============================== TRIM PARAMETER  ==============================
; =============================================================================
; ===                                                                       ===
; ===   [PARAMETER NAME]                                                    ===
; ===                                                                       ===
; ===   Target          = TRIM TARGET (with unit conversion  eg. u=10e-6 )  ===
; ===   Trim_type       = TRIM TYPE   ("abs", "rel", "min" or "max" )       ===
; ===   Table           = TRIM TABLE  ("*0%, -0.362%" or "5mv, *10mV")      ===
; ===                                   ^                      ^            ===
; ===                                   |                      |            ===
; ===             START VALUE ( value copied into working after dut.sot() ) ===
; ===                                                                       ===
; ===   Trim_start_adj  = ADJUST START VALUE ("true" or "false")            ===
; ===                                                                       ===
; =============================================================================

;================== GROUP I Reference and Clock ======================

[Trim_BGR_VREF]
Target         		=  1.215 V 		
Trim_type      		= nom
Table               = *1,2,3,4,5,6,7,8
Trim_start_learn    = 40
Trim_step_learn     = 40
Trim_step_char      = 40

; =============================================================================
; ============================== Bit Fields ===================================
; =============================================================================
; ===                                                                       === 
; ===    Version      =    0x1010                                           ===
; ===       ^                 ^                                             ===
; ===       |                 |                                             ===
; ===   SETTING NAME          |                                             ===
; ===                         |                                             ===
; ===                    SETTING VALUE                                      ===
; ===                binary: b1010 = int 10                                 ===
; ===                int:     1010 = int 1010                               ===
; ===                hex:   0x1010 = int 4112                               ===
; ===                                                                       === 
; =============================================================================

[*GENERAL]
Fill_0				= 0
Fill_1				= 1
Dummy				= 0 ;  

Fill_0x42 = 0x00

; =============================================================================
; ==============================  Build Words  ================================
; =============================================================================
; ===                                                                       === 
; ===   0:             bandgap       =         !                  1         ===
; ===   ^                ^                     ^                  ^         ===
; ===   |                |                     |                  |         ===                            
; === BIT POS in REG     |                     |                  |         ===
; ===                    |                     |                  |         ===
; ===          PARAMETER or SETTING NAME       |                  |         ===
; ===                                          |                  |         === 
; ===                        INVERT BIT (if '!' is present)       |         ===
; ===                                                                       ===
; ===                                     BIT POS in PARAMETER or SETTING   ===
; ===                                                                       ===
; =============================================================================

[_OTP_0x4408]
0:  Trim_BGR_VREF			        = 0
1:  Trim_BGR_VREF			        = 1
2:  Trim_BGR_VREF                   = 2
3:  Dummy							= 0
4:  Dummy			        = 0
5:  Dummy                  = 1
6:  Dummy                   = 2
7:  Dummy			        = 3
8:  Dummy					= 4
9:  Dummy						    = 0
10: Dummy			                = 0
11: Dummy                           = 0
12: Dummy                           = 0
13: Dummy			                = 0
14: Dummy                           = 0
15: Dummy                           = 0

; =============================================================================
; =============================  Register Groups  =============================
; =============================================================================
; ===                                                                       === 
; ===   0:									  0x09_soft       =        0x09															"write_0x09"   ===
; ===   ^										^									  ^															^         ===
; ===   |											 |										|															 |         ===                            
; === LINE NUMBER					 |										|															 |         ===
; ===												|										|															 |         ===
; ===											REGISTER NAME               |															 |         ===
; ===																						 |															 |         === 
; ===																			 ADDRESS send through INTERFACE        |         ===
; ===																																					 |         ===
; ===																																				LABEL in VECTOR FILE (optional)    ===
; ===																																					 ===
; =============================================================================       


[#OTP_Cell]
0:	OTP_0x4408		=0x4408







   