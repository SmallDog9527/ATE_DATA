; =============================================================================
; ============================== Bit Fields ===================================
; =============================================================================
; ===                                                                       === 
; ===    Version      =    0x1010                                           ===
; ===       ^                 ^                                             ===
; ===       |                 |                                             ===
; ===   SETTING NAME          |                                             ===
; ===                         |                                             ===
; ===                    SETTING VALUE                                      ===
; ===                binary: b1010 = int 10                                 ===
; ===                int:     1010 = int 1010                               ===
; ===                hex:   0x1010 = int 4112                               ===
; ===                                                                       === 
; =============================================================================

[*GENERAL]
Fill_0				= 0
Fill_1				= 1
Dummy				= 0 ;  

;Fill_0x41 = 0x01  ;VerBB
Fill_0x42 = 0x00
;Fill_0x43 = 0x04 ; ldo31=10b:3.1V
Fill_0x46 = 0x00
Fill_0x48 = 0x00
Fill_0x4A = 0x00
;Fill_0x4B = 0x02  ;ccsbu_clamp=10b, 3.8V 20250708
; =============================================================================
; ==============================  Build Words  ================================
; =============================================================================
; ===                                                                       === 
; ===   0:             bandgap       =         !                  1         ===
; ===   ^                ^                     ^                  ^         ===
; ===   |                |                     |                  |         ===                            
; === BIT POS in REG     |                     |                  |         ===
; ===                    |                     |                  |         ===
; ===          PARAMETER or SETTING NAME       |                  |         ===
; ===                                          |                  |         === 
; ===                        INVERT BIT (if '!' is present)       |         ===
; ===                                                                       ===
; ===                                     BIT POS in PARAMETER or SETTING   ===
; ===                                                                       ===
; =============================================================================

[_OTP_0x40]
0:  trm_bg						    = 0
1:  trm_bg			                = 1
2:  trm_bg                          = 2
3:  trm_bg                          = 3
4:  trim_bg_tc			            = 0
5:  trim_bg_tc                      = 1
6:  trim_bg_tc				        = 2
7:  trim_bg_tc				        = 3

[_OTP_0x41]
0:  trm_iref						= 0
1:  trm_iref			            = 1
2:  trm_iref                        = 2
3:  trm_iref                        = 3
4:  trm_osc			                = 0
5:  trm_osc                         = 1
6:  trm_osc				            = 2
7:  trm_inc_snksrcp		            = 0

[_OTP_0x42]
