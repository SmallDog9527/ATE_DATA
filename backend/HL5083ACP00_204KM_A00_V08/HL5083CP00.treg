; =============================================================================
; =============================  Register Groups  =============================
; =============================================================================
; ===                                                                       === 
; ===   0:									  0x09_soft       =        0x09															"write_0x09"   ===
; ===   ^										^									  ^															^         ===
; ===   |											 |										|															 |         ===                            
; === LINE NUMBER					 |										|															 |         ===
; ===												|										|															 |         ===
; ===											REGISTER NAME               |															 |         ===
; ===																						 |															 |         === 
; ===																			 ADDRESS send through INTERFACE        |         ===
; ===																																					 |         ===
; ===																																				LABEL in VECTOR FILE (optional)    ===
; ===																																					 ===
; =============================================================================       

[#OTP_Cell]
0:  OTP_0x40    	=0x40		;"wr_0x40"
1:  OTP_0x41    	=0x41		;"wr_0x41"
2:  OTP_0x42    	=0x42		;"wr_0x42"
3:  OTP_0x43		=0x43		;"wr_0x43"
4:  OTP_0x44		=0x44		;"wr_0x44"
5:  OTP_0x45		=0x45		;"wr_0x45"
6:  OTP_0x46		=0x46		;"wr_0x46"
7:	OTP_0x47		=0x47		;"wr_0x47"
8:  OTP_0x48		=0x48		;"wr_0x48"
9:	OTP_0x49		=0x49		;"wr_0x49"
10:	OTP_0x4A		=0x4A		;"wr_0x4A"
11:	OTP_0x4B		=0x4B		;"wr_0x4B"
  






   